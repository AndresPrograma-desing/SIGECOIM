PORT=3003

# PostgreSQL (Supabase) — Project Settings → Database → Connection string
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_USER=postgres.<project-ref>
DB_PASS=
DB_NAME=postgres
DB_PORT=6543

JWT_SECRET=

# URL pública del frontend desplegado (ej. en Vercel), para CORS. Separar por
# coma si hay más de una (ej. dominio de producción + dominio custom). Los
# dominios *.vercel.app (previews) y localhost/LAN/devtunnels ya están
# permitidos automáticamente — esta variable es para dominios adicionales.
FRONTEND_URL=https://tu-app.vercel.app
