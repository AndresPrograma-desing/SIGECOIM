# En desarrollo local, deja esta variable sin definir: apiClient.js auto-detecta
# localhost:3003 / IP de LAN / devtunnels automáticamente (ver resolveBaseURL).
#
# En producción (Vercel), definir como variable de entorno del proyecto en el
# dashboard de Vercel (Settings → Environment Variables), con la URL pública
# del backend desplegado (incluyendo el sufijo /api):
VITE_API_URL=https://tu-backend.onrender.com/api
